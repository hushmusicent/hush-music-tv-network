    "accessibility": {
      "contrast_check": "Ensure 4.5:1 contrast for text over video backgrounds using overlays",
      "focus_states": "Visible outline-2 outline-primary for keyboard navigation (TV remote simulation)",
      "reduced_motion": "Disable smooth scrolling and parallax if prefers-reduced-motion is true"
    },
    "instructions_to_main_agent": [
      "1. FONT SETUP: Add the Google Fonts links to public/index.html immediately.",
      "2. TAILWIND CONFIG: Update tailwind.config.js to extend the font family: 'heading': ['Bebas Neue', 'sans-serif'], 'sans': ['Manrope', 'sans-serif'].",
      "3. SHADCN OVERRIDES: Dark mode is default. Force 'dark' class on the html element.",
      "4. LAYOUT: Implement the 'TV Guide' grid using CSS Grid (not Tables). It must scroll horizontally while keeping channel names sticky on the left.",
      "5. PLAYER: The video player should be the 'Hero' of the channel page. Use aspect-video w-full.",
      "6. DATA-TESTID: Add data-testid attributes to all buttons, inputs, and channel cards."
    ],
    "universal_guidelines": [
      "Avoid 'AI Slop' - no generic centered layouts.",
      "Use depth (z-index, shadows, overlays) to create immersion.",
      "Micro-animations on hover are mandatory for a premium feel.",
      "Do not use gradients for text, only for backgrounds or accents.",
      "Use 'sonner' for toasts.",
      "Use 'lucide-react' for icons."
    ]
  }
