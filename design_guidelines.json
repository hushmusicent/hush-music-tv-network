{
  "design_system": {
    "identity": {
      "name": "Strimm Clone",
      "personality": "Cinematic, Immersive, Infinite, Curated",
      "archetype": "Electric & Neon",
      "theme_mode": "dark"
    },
    "typography": {
      "fonts": [
        {
          "role": "heading",
          "name": "Bebas Neue",
          "url": "https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap",
          "class": "font-heading",
          "usage": "Page titles, Hero text, Channel Names"
        },
        {
          "role": "body",
          "name": "Manrope",
          "url": "https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap",
          "class": "font-sans",
          "usage": "UI text, descriptions, metadata"
        }
      ],
      "scale": {
        "h1": "text-6xl md:text-8xl tracking-tight leading-none",
        "h2": "text-4xl md:text-5xl tracking-tight",
        "h3": "text-2xl md:text-3xl font-semibold",
        "body": "text-base text-gray-300",
        "label": "text-xs font-bold tracking-widest uppercase text-gray-500"
      }
    },
    "colors": {
      "palette": {
        "background": {
          "default": "#0A0A0A",
          "surface": "#121212",
          "overlay": "rgba(10, 10, 10, 0.8)"
        },
        "primary": {
          "main": "#7C3AED",
          "hover": "#6D28D9",
          "glow": "0 0 20px rgba(124, 58, 237, 0.5)"
        },
        "accent": {
          "lime": "#CCF381",
          "cyan": "#06B6D4",
          "rose": "#F43F5E"
        },
        "text": {
          "primary": "#FFFFFF",
          "secondary": "#A3A3A3",
          "muted": "#525252"
        },
        "status": {
          "live": "#EF4444",
          "success": "#22C55E",
          "warning": "#EAB308"
        }
      },
      "gradients": {
        "hero_fade": "linear-gradient(to top, #0A0A0A 10%, transparent 100%)",
        "brand_glow": "radial-gradient(circle at center, rgba(124, 58, 237, 0.15) 0%, transparent 70%)"
      }
    },
    "layout": {
      "spacing": {
        "container_padding": "px-6 md:px-12 lg:px-16",
        "section_gap": "gap-12 md:gap-20",
        "item_gap": "gap-4 md:gap-6"
      },
      "grids": {
        "tv_guide": "grid grid-cols-[100px_1fr] overflow-hidden",
        "channel_list": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6",
        "bento_hero": "grid grid-cols-1 md:grid-cols-12 gap-4"
      }
    },
    "ui_components": {
      "glassmorphism": {
        "default": "bg-black/40 backdrop-blur-xl border border-white/10",
        "heavy": "bg-black/80 backdrop-blur-2xl border border-white/5",
        "hover": "hover:bg-white/5 transition-colors duration-300"
      },
      "buttons": {
        "primary": "bg-primary text-white rounded-none font-bold tracking-wider hover:bg-primary/90 transition-all shadow-[0_0_15px_rgba(124,58,237,0.3)] hover:shadow-[0_0_25px_rgba(124,58,237,0.5)]",
        "ghost": "bg-transparent text-white border border-white/20 hover:bg-white/10 rounded-none",
        "icon": "p-2 rounded-full hover:bg-white/10 text-white transition-colors"
      },
      "cards": {
        "video_thumbnail": "aspect-video bg-zinc-900 rounded-sm overflow-hidden group relative border border-transparent hover:border-white/20 transition-all",
        "channel_tile": "aspect-square bg-zinc-900 rounded-lg p-6 flex flex-col items-center justify-center border border-white/5 hover:border-primary/50 transition-all hover:bg-zinc-800"
      }
    },
