<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
    </interface>

    <children>
        <Rectangle id="bg" width="300" height="200" color="0x111111FF" />
        <Poster
            id="poster"
            width="300"
            height="170"
            loadDisplayMode="scaleToFill"
            failedBitmapUri="pkg:/images/icon_side_hd.png"
        />
        <Label
            id="title"
            width="300"
            height="26"
            translation="[0, 172]"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            font="font:SmallBoldSystemFont"
        />
        <Rectangle id="focusRing" width="300" height="200" color="0x8B5CF6FF" opacity="0" />
    </children>

    <script type="text/brightscript"><![CDATA[
        sub init()
            m.poster    = m.top.findNode("poster")
            m.titleLbl  = m.top.findNode("title")
            m.focusRing = m.top.findNode("focusRing")
        end sub

        sub onContentChange()
            item = m.top.itemContent
            if item <> invalid
                m.poster.uri    = item.HDGRIDPOSTERURL
                m.titleLbl.text = item.title
            end if
        end sub

        sub onFocusChange()
            m.focusRing.opacity = m.top.focusPercent
        end sub
    ]]></script>
</component>
