<?xml version="1.0" encoding="utf-8" ?>
<component name="LivePlayer" extends="Group">
    <interface>
        <field id="apiBase" type="string" />
        <field id="channel" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Label
            translation="[0, 500]"
            width="1920"
            height="60"
            horizAlign="center"
            text="LivePlayer OK"
            color="0xFFFFFFFF"
            font="font:MediumBoldSystemFont" />
    </children>
    <script type="text/brightscript"><![CDATA[
        sub init()
        end sub

        function onKeyEvent(key as String, press as Boolean) as Boolean
            if not press then return false
            if key = "back"
                m.top.closed = true
                return true
            end if
            return false
        end function
    ]]></script>
</component>
